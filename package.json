{
  "name": "weft",
  "private": true,
  "version": "0.1.0",
  "description": "Weft — a real-time collaborative editor built on a CRDT (offline-first, no lost edits).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check": "npm run typecheck && npm run lint && npm test && npm run bench && npm run e2e",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . && node tools/lint-deps.mjs && node tools/lint-pure.mjs",
    "test": "npm test --workspaces --if-present",
    "bench": "node --expose-gc tools/bench.mjs",
    "dev:server": "node packages/server/src/main.ts",
    "docs:check": "node tools/check-docs.mjs",
    "dev": "node tools/dev.mjs",
    "e2e": "playwright test -c packages/client/playwright.config.ts",
    "prepare": "husky",
    "smoke:live": "node tools/live-smoke.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^3.2.7",
    "cross-env": "^10.1.0",
    "eslint": "^10.0.0",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.5.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.50.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
